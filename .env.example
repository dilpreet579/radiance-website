# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Radiance 2026 <tickets@yourdomain.com>"
# A monitored inbox students can reply to (replies to a no-reply address look spammy)
EMAIL_REPLY_TO=

# Public URL of the deployed site (used for QR image links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Fallback if the settings table has no value; flip to true on 26 Oct
NEXT_PUBLIC_COMPETITIONS_LIVE=false
